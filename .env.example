# Solo valores públicos diseñados para el navegador; nunca secret/service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# RAWG_API_KEY se configura únicamente en secretos del servidor/Edge Function.
# curated (por defecto) o rawg (servidor explícito, nunca fallback ante error).
VITE_CATALOG_MODE=curated
