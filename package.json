{
  "name": "gamehive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write src tests *.{ts,js,json,html}",
    "format:check": "prettier --check src tests *.{ts,js,json,html}",
    "test:backend": "node scripts/local-backend-tests.mjs",
    "test:sql": "supabase test db --local",
    "test:catalog:db": "node scripts/test-catalog-db.mjs",
    "test:manual": "node scripts/local-manual-tests.mjs",
    "test:manual:db": "node scripts/test-manual-db.mjs",
    "test:reviews": "node scripts/local-reviews-tests.mjs",
    "test:reviews:db": "node scripts/test-reviews-db.mjs",
    "test:votes": "node scripts/local-votes-tests.mjs",
    "test:votes:db": "node scripts/test-votes-db.mjs",
    "test:library": "node scripts/local-library-tests.mjs",
    "test:library:db": "node scripts/test-library-db.mjs",
    "test:applications": "node scripts/local-applications-tests.mjs",
    "test:applications:db": "node scripts/test-applications-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bmad-method": "6.12.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
